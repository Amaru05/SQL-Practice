select
s.student_id,
s.name,
count(c.course_id)as total_count,
rank()over(order by count(c.course_id)desc)as rank_by_enrollments,
dense_rank()over(order by count(c.course_id)desc)as dense_rank
from Enrollments e join Courses c 
on e.course_id=c.course_id
join Students s on
s.student_id=e.student_id
group by s.student_id,s.name
order by rank_by_enrollments;




