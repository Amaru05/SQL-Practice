select
dp.department_name,
d.doctor_name,
sum(b.amount) as total_revenue,
rank()over(partition by dp.dept_id order by sum(b.amount)desc)as revenue_rank
from Appointments a  join Doctors d on
a.doctor_id=d.doctor_id
join Bills b on
b.appointment_id=a.appointment_id
join Departments dp on
d.dept_id=dp.dept_id
group by dp.department_name,dp.dept_id,d.doctor_name;





